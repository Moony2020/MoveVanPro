# MoveVan Pro Enterprise Environment Variables Template
# Copy this file to .env and fill in your confidential API keys

# Stripe Payment Gateway Keys
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
VITE_STRIPE_ENVIRONMENT=sandbox

# PayPal Gateway Keys
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here
VITE_PAYPAL_CURRENCY=USD

# System Configuration & Security Settings
VITE_API_BASE_URL=https://api.movevanpro.com/v1
VITE_ENABLE_LIVE_PAYMENTS=true
VITE_PAYMENT_SECURITY_HASH=sec_your_security_hash_here
