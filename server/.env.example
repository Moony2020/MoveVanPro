PORT=5000
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173

# Stripe test-mode credentials: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal Sandbox app credentials: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_ENVIRONMENT=sandbox

# Local admin account creation. Only this email can create the first admin account.
ADMIN_ALLOWED_EMAIL=admin@example.com
AUTH_TOKEN_SECRET=change-this-long-random-secret

# Password reset emails (create an API key at https://resend.com/api-keys).
# PASSWORD_RESET_FROM must be a sender address verified by your email provider.
RESEND_API_KEY=re_...
PASSWORD_RESET_FROM=MoveVan Pro <noreply@your-domain.com>
